# Aegis AI Gateway Environment Configuration Template

# --- Multi-Provider Upstream Routing ---
# Options: "groq" (Recommended: 14.4k req/day free) | "openai" | "ollama" | "custom"
UPSTREAM_PROVIDER=groq

# Groq (Free API Key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (Optional)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini / Custom OpenAI-Compatible (Optional)
# PRIMARY_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PRIMARY_API_KEY=your-gemini-key
# PRIMARY_MODEL=gemini-2.5-flash-lite

SEMANTIC_SIMILARITY_THRESHOLD=0.80
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DEFAULT_RATE_LIMIT_RPS=20
DEFAULT_BURST_CAPACITY=50

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=15.0
CIRCUIT_TIMEOUT_SECONDS=10.0

# --- Security (required) ---------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If missing or left as "change-me", admin endpoints are disabled.
ADMIN_API_KEY=change-me
# Client keys, "key:tenant" pairs separated by commas.
TENANT_API_KEYS=sk-replace-me-with-a-long-random-key:tenant-a
# Enables publicly known dev keys (sk-aegis-tenant-alpha, ...). Local demos only.
AEGIS_DEV_MODE=false

CACHE_DEFAULT_TTL_SECONDS=300.0
# Upper bound for the client-controlled X-Cache-TTL header
CACHE_MAX_TTL_SECONDS=86400.0
