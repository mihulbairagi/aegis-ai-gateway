# Aegis AI Gateway Environment Configuration Template
PRIMARY_PROVIDER_URL=https://api.routerplus.com/v1
PRIMARY_API_KEY=your-primary-api-key-here
PRIMARY_MODEL=claude-sonnet-5-5

FALLBACK_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_API_KEY=mock-fallback-key
FALLBACK_MODEL=gemini-2.0-flash

SEMANTIC_SIMILARITY_THRESHOLD=0.80
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DEFAULT_RATE_LIMIT_RPS=20
DEFAULT_BURST_CAPACITY=50

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=15.0
CIRCUIT_TIMEOUT_SECONDS=10.0

ADMIN_API_KEY=admin-secret-key-12345
CACHE_DEFAULT_TTL_SECONDS=300.0
